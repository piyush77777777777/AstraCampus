# AstraCampus Environment Configuration Example
# Copy this file to .env and adjust variables as needed

HOST=127.0.0.1
PORT=8000
ENVIRONMENT=production
DEBUG=false

# Dataset & Export Paths
DATA_PATH=backend/data/cit_public.json
EXPORTS_DIR=exports/

# LLM Gateway API Key (Optional: system operates offline with built-in rule parser)
GEMINI_API_KEY=your_gemini_api_key_here
